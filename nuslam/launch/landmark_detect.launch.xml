<?xml version="1.0" encoding="UTF-8"?>
<launch>
    <arg name="robot" default="nusim"/>
    <arg name="use_rviz" default="true"/>

    <node pkg="nuslam" exec="landmark" name="landmark" on_exit="shutdown"
        if="$(eval '\'$(var robot)\' == \'nusim\'')"/>

    <node pkg="rviz2" exec="rviz2" name="rviz2" on_exit="shutdown"
        args="-d $(find-pkg-share nuslam)/config/landmark.rviz"
        if="$(var use_rviz)"/>

    <include file="$(find-pkg-share nusim)/launch/nusim.launch.xml">
        <arg name="robot" value="$(var robot)"/>
        <arg name="use_rviz" value="false"/>
    </include>
</launch>