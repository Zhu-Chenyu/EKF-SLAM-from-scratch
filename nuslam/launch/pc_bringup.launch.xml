<launch>

    <include file="$(find-pkg-share nuturtle_description)/launch/load_one.launch.xml">
        <arg name="use_rviz" value="false"/>
        <arg name="use_jsp" value="true"/>
        <arg name="color" value="blue"/>
    </include>

    <include file="$(find-pkg-share nuturtle_description)/launch/load_one.launch.xml">
        <arg name="use_rviz" value="false"/>
        <arg name="use_jsp" value="true"/>
        <arg name="color" value="green"/>
    </include>

    <node pkg="nuslam" exec="nuslam" name="nuslam">
        <remap from="sensor_data" to="landmark"/>
    </node>

    <node
    pkg="tf2_ros" exec="static_transform_publisher"
    args="--x 0.0 --y 0 --z 0 --yaw 0 --pitch 0 --roll 0 --frame-id nusim/world --child-frame-id map"
    />

    <node pkg="rviz2" exec="rviz2" on_exit="shutdown" args="-d $(find-pkg-share nuslam)/config/pc_bringup.rviz"/>
    <node pkg="teleop_twist_keyboard" exec="teleop_twist_keyboard" name="teleop" output="screen" launch-prefix="xterm -e"/>

</launch>