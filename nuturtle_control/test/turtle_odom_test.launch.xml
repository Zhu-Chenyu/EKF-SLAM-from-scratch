<?xml version="1.0" encoding="UTF-8"?>
<launch>
    <node pkg="nuturtle_control" exec="odometry" name="odometry" on_exit="shutdown">
        <param from="$(find-pkg-share nuturtle_description)/config/diff_params.yaml"/>
        <param name="wheel_left" value="left_wheel_joint"/>
        <param name="wheel_right" value="wheel_right_joint"/>
    </node>

    <node pkg="nuturtle_control" exec="turtle_odom_test" name="turtle_odom_test" on_exit="shutdown"/>
</launch>