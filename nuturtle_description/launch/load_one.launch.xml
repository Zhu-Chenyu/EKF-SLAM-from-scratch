<?xml version="1.0" encoding="UTF-8"?>
<launch>
    <arg name="use_rviz" default="true" />
    <arg name="use_jsp" default="true" />
    <arg name="color" default="purple" >
        <choice value="red"/>
        <choice value="green"/>
        <choice value="blue"/>
        <choice value="purple"/>
    </arg>

    <node pkg="robot_state_publisher" exec="robot_state_publisher" name="robot_state_publisher" namespace="$(var color)">
        <param name="frame_prefix" value="$(var color)/"/>
        <param name="robot_description"
            value="$(command 'xacro $(find-pkg-share nuturtle_description)/urdf/turtlebot3_burger.urdf.xacro color:=$(var color)')"/>
    </node>

    <node pkg="joint_state_publisher" exec="joint_state_publisher" namespace="$(var color)"
        if="$(eval '\'$(var use_jsp)\' == \'true\'')"/>

    <node pkg="rviz2" exec="rviz2" name="rviz2" on_exit="shutdown" namespace="$(var color)/" args="-d $(find-pkg-share nuturtle_description)/config/$(var color)_turtlebot_view.rviz"
        if="$(eval '\'$(var use_rviz)\' == \'true\'')"/>
</launch>