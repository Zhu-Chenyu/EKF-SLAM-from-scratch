<?xml version="1.0" encoding="UTF-8"?>
<launch>
    <arg name="use_rviz" default="true" description="Open rviz"/>
    <arg name="use_jsp" default="true" description="Use joint state publisher"/>
    <arg name="world_frame" default="nusim/world" description="Select the world frame"/>

    <node pkg="rviz2" exec="rviz2" name="rviz2" on_exit="shutdown" args="-d $(find-pkg-share nuturtle_description)/config/basic_all.rviz"
            if="$(eval '\'$(var use_rviz)\' == \'true\'')"/>

    <include file="$(find-pkg-share nuturtle_description)/launch/load_one.launch.xml">
        <arg name="use_rviz" value="false"/>
        <arg name="color" value="red"/>
        <arg name="use_jsp" value="$(var use_jsp)"/>
    </include>

    <include file="$(find-pkg-share nuturtle_description)/launch/load_one.launch.xml">
        <arg name="use_rviz" value="false"/>
        <arg name="color" value="green"/>
        <arg name="use_jsp" value="$(var use_jsp)"/>
    </include>

    <include file="$(find-pkg-share nuturtle_description)/launch/load_one.launch.xml">
        <arg name="use_rviz" value="false"/>
        <arg name="color" value="blue"/>
        <arg name="use_jsp" value="$(var use_jsp)"/>
    </include>

    <include file="$(find-pkg-share nuturtle_description)/launch/load_one.launch.xml">
        <arg name="use_rviz" value="false"/>
        <arg name="color" value="purple"/>
        <arg name="use_jsp" value="$(var use_jsp)"/>
    </include>

    <node pkg="tf2_ros" exec="static_transform_publisher" name="world_to_red"
        args="--x 0.25 --y 0 --z 0 --yaw 0 --pitch 0 --roll 0 --frame-id $(var world_frame) --child-frame-id red/base_footprint"/>

    <node pkg="tf2_ros" exec="static_transform_publisher" name="world_to_green"
        args="--x 0 --y 0.5 --z 0 --yaw 0 --pitch 0 --roll 0 --frame-id $(var world_frame) --child-frame-id green/base_footprint"/>

    <node pkg="tf2_ros" exec="static_transform_publisher" name="world_to_blue"
        args="--x -0.5 --y 0 --z 0 --yaw 0 --pitch 0 --roll 0 --frame-id $(var world_frame) --child-frame-id blue/base_footprint"/>

    <node pkg="tf2_ros" exec="static_transform_publisher" name="world_to_purple"
        args="--x 0 --y -1.0 --z 0 --yaw 0 --pitch 0 --roll 0 --frame-id $(var world_frame) --child-frame-id purple/base_footprint"/>

</launch>